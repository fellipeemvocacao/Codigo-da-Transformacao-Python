import shutil
import os
from datetime import datetime

# Configurações de caminhos
PASTA_ORIGEM = "meus_documentos"
PASTA_DESTINO = "backup_sistema"

def realizar_backup():
    # 1. Verificar se a pasta de origem existe
    if not os.path.exists(PASTA_ORIGEM):
        print(f"❌ Erro: A pasta de origem '{PASTA_ORIGEM}' não foi encontrada.")
        return

    # 2. Criar um nome único para a pasta de backup (ex: backup_20231027_1530)
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    pasta_final_backup = os.path.join(PASTA_DESTINO, f"backup_{timestamp}")

    try:
        # 3. Criar a pasta de destino se não existir
        if not os.path.exists(PASTA_DESTINO):
            os.makedirs(PASTA_DESTINO)
            print(f"📁 Pasta principal de destino criada: {PASTA_DESTINO}")

        # 4. Copiar toda a árvore de diretórios
        # copytree cria a pasta de destino automaticamente
        shutil.copytree(PASTA_ORIGEM, pasta_final_backup)
        
        print(f"✅ Backup concluído com sucesso!")
        print(f"📂 De: {PASTA_ORIGEM}")
        print(f"📂 Para: {pasta_final_backup}")

    except Exception as e:
        print(f"⚠️ Ocorreu um erro durante o backup: {e}")

if __name__ == "__main__":
    realizar_backup()
